'use client';

import { Suspense, useEffect, useState, type ChangeEvent } from 'react';
import { useRouter, useSearchParams } from 'next/navigation';
import type { ExternalItem } from '@/lib/external';

export default function BlogSpaPage() {
  return (
    <Suspense fallback={<div className="p-8 text-center text-gray-500">กำลังโหลด...</div>}>
      <BlogSpaContent />
    </Suspense>
  );
}

function BlogSpaContent() {
  const router = useRouter();
  const searchParams = useSearchParams();

  const initialSource = searchParams.get('source') === 'news' ? 'news' : 'products';
  const initialQuery = searchParams.get('q') || '';
  const initialSelectedId = searchParams.get('selected') || null;

  const [source, setSource] = useState<'products' | 'news'>(initialSource);
  const [searchQuery, setSearchQuery] = useState<string>(initialQuery);
  const [selectedItem, setSelectedItem] = useState<ExternalItem | null>(null);
  const [items, setItems] = useState<ExternalItem[]>([]);
  const [isLoading, setIsLoading] = useState<boolean>(true);
  const [error, setError] = useState<string | null>(null);

  useEffect(() => {
    setSource(initialSource);
    setSearchQuery(initialQuery);
  }, [initialSource, initialQuery]);

  const updateURL = (newSource: string, newQuery: string, selectedId: string | null) => {
    const params = new URLSearchParams();
    params.set('source', newSource);
    if (newQuery.trim()) {
      params.set('q', newQuery);
    }
    if (selectedId) {
      params.set('selected', selectedId);
    }

    const queryString = params.toString();
    router.replace(`/blog-spa${queryString ? `?${queryString}` : ''}`);
  };

  useEffect(() => {
    setIsLoading(true);
    setError(null);

    fetch(`/api/aggregate?source=${source}`)
      .then((response) => {
        if (!response.ok) throw new Error('ดึงข้อมูลจาก API ไม่สำเร็จ');
        return response.json();
      })
      .then((data: { external?: ExternalItem[]; error?: string }) => {
        if (data.error) {
          setError(data.error);
          setItems([]);
          setSelectedItem(null);
        } else {
          const externalItems = data.external || [];
          setItems(externalItems);

          if (initialSelectedId) {
            const found = externalItems.find((item: ExternalItem) => item.id === initialSelectedId);
            setSelectedItem(found || null);
          } else {
            setSelectedItem(null);
          }
        }
      })
      .catch((err) => {
        setError(err.message || 'เกิดข้อผิดพลาดในการโหลดข้อมูล');
        setItems([]);
        setSelectedItem(null);
      })
      .finally(() => setIsLoading(false));
  }, [source, initialSelectedId]);

  const filteredItems = items.filter((item) => {
    const haystack = `${item.title} ${item.subtitle || ''}`.toLowerCase();
    return haystack.includes(searchQuery.toLowerCase());
  });

  const handleSourceChange = (newSource: 'products' | 'news') => {
    setSource(newSource);
    setSearchQuery('');
    setSelectedItem(null);
    updateURL(newSource, '', null);
  };

  const handleSearchChange = (value: string) => {
    setSearchQuery(value);
    updateURL(source, value, selectedItem?.id || null);
  };

  const handleSelectItem = (item: ExternalItem | null) => {
    setSelectedItem(item);
    updateURL(source, searchQuery, item ? item.id : null);
  };

  return (
    <main className="p-8 max-w-4xl mx-auto">
      <h1 className="text-2xl font-bold text-blue-900 mb-6">🧩 Blog Aggregator (SPA)</h1>

      <div className="flex flex-col sm:flex-row gap-4 justify-between mb-6">
        <div className="flex gap-2">
          <button
            onClick={() => handleSourceChange('products')}
            className={`px-4 py-2 rounded-lg font-medium transition ${
              source === 'products' ? 'bg-blue-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'
            }`}
          >
            Products
          </button>
          <button
            onClick={() => handleSourceChange('news')}
            className={`px-4 py-2 rounded-lg font-medium transition ${
              source === 'news' ? 'bg-blue-600 text-white' : 'bg-gray-100 text-gray-700 hover:bg-gray-200'
            }`}
          >
            News
          </button>
        </div>

        <input
          type="text"
          placeholder="พิมพ์ค้นหาได้เลย..."
          value={searchQuery}
          onChange={(event: ChangeEvent<HTMLInputElement>) => handleSearchChange(event.target.value)}
          className="px-4 py-2 border rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500"
        />
      </div>

      {isLoading ? (
        <div className="text-center py-12">
          <div className="inline-block animate-spin rounded-full h-8 w-8 border-4 border-blue-500 border-t-transparent"></div>
          <p className="mt-2 text-gray-500">กำลังโหลดข้อมูลครับ...</p>
        </div>
      ) : error ? (
        <div className="bg-red-50 border border-red-200 text-red-700 p-4 rounded-lg text-center">
          <p className="font-bold">⚠️ เกิดข้อผิดพลาด</p>
          <p className="text-sm">{error}</p>
        </div>
      ) : filteredItems.length === 0 ? (
        <div className="bg-gray-50 border border-dashed border-gray-300 p-8 text-center rounded-lg">
          <p className="text-gray-500">🔍 ไม่พบข้อมูลที่ค้นหา &quot;{searchQuery}&quot;</p>
        </div>
      ) : (
        <div className="grid grid-cols-1 md:grid-cols-2 gap-4">
          {filteredItems.map((item) => (
            <div
              key={item.id}
              onClick={() => handleSelectItem(item)}
              className="p-4 bg-white rounded-lg border hover:shadow-md transition cursor-pointer flex gap-4 items-center"
            >
              {item.image && (
                <img src={item.image} alt={item.title} className="w-16 h-16 object-contain rounded" />
              )}
              <div className="overflow-hidden">
                <h2 className="font-bold text-blue-800 truncate">{item.title}</h2>
                <p className="text-gray-500 text-sm truncate">{item.subtitle}</p>
                <span className="text-xs text-blue-500 mt-1 inline-block">คลิกเพื่อดูเพิ่มเติม →</span>
              </div>
            </div>
          ))}
        </div>
      )}

      {selectedItem && (
        <div className="fixed inset-0 bg-black/50 flex items-center justify-center p-4 z-50">
          <div className="bg-white p-6 rounded-xl max-w-lg w-full shadow-2xl relative">
            <h2 className="text-xl font-bold text-gray-900 mb-2">{selectedItem.title}</h2>
            {selectedItem.image && (
              <img src={selectedItem.image} alt={selectedItem.title} className="w-full h-48 object-contain my-4" />
            )}
            <p className="text-gray-600 mb-4">{selectedItem.subtitle || 'ไม่มีรายละเอียดเพิ่มเติม'}</p>
            <p className="text-xs text-gray-400 mb-6">ID Reference: {selectedItem.id}</p>

            <button
              onClick={() => handleSelectItem(null)}
              className="w-full py-2 bg-gray-800 text-white rounded-lg font-medium hover:bg-gray-900 transition"
            >
              ปิด
            </button>
          </div>
        </div>
      )}
    </main>
  );
}
